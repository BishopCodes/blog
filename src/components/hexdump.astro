---
// Easter egg: hex-dump backdrop, fully static, zero client JS.
//
// The texture is pre-generated as small SVG tiles (pnpm generate:hex,
// scripts/generate-hex-tile.mjs) instead of inlined data URIs, so each page
// ships only this CSS. The browser fetches exactly one tile per session —
// picked by viewport width and reduced-motion — and caches it; the SMIL
// "lit byte" animation runs inside the background image. If a browser doesn't
// run SMIL in background images it degrades to the static texture.
//
// Desktop tile: 14 px type, 924 px wide (old `.hexrow` cap: min(100%, 110ch)).
// Compact tile: 11 px type (the clamp() minimum) for viewports under 924 px.
---

<style>
  .hexdump {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background-image: url("/hex-tile.svg");
    background-repeat: repeat-y;
    background-position: 50% 0.75rem;
    -webkit-mask-image: linear-gradient(to bottom, black 55%, transparent 97%);
    mask-image: linear-gradient(to bottom, black 55%, transparent 97%);
  }

  @media (max-width: 923px) {
    .hexdump {
      background-image: url("/hex-tile-mobile.svg");
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hexdump {
      background-image: url("/hex-tile-still.svg");
    }
  }

  @media (max-width: 923px) and (prefers-reduced-motion: reduce) {
    .hexdump {
      background-image: url("/hex-tile-mobile-still.svg");
    }
  }
</style>

<div class="hexdump" aria-hidden="true"></div>
