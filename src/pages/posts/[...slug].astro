---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";

dayjs.extend(utc);

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const lastModified = dayjs(remarkPluginFrontmatter.lastModified)
  .utc()
  .format("MMM DD, YYYY");
const createdOn = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const tagClassMap = {
  code: "text-cyan-400",
  rant: "text-red-400",
  architecture: "text-amber-400",
  opinion: "text-teal-400",
  talk: "text-neutral-200",
};
---

<Layout title={`${post.data.title} — BishopCodes`}>
  <a
    href="/"
    transition:persist
    aria-label="Back to all posts"
    class="text-sm text-neutral-400 transition-colors hover:text-cyan-300"
  >
    <span class="text-blue-400">$</span>
    <span class="ml-2">cd ..</span>
  </a>

  <p transition:persist class="mt-6 text-sm text-neutral-400">
    <span class="text-blue-400">$</span>
    <span class="ml-2 text-green-400">bat</span>
    <span class="ml-2 text-neutral-300">./posts/{post.id}.md</span>
  </p>

  <div transition:animate="slide" class="mt-6">
    <article>
      <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-xs">
        <span class={tagClassMap[post.data.tag]}>
          {`[${post.data.tag}]`}
        </span>
        <span class="text-neutral-700" aria-hidden="true">·</span>
        <span class="text-neutral-500">
          Created
          <time
            class="ml-1 text-neutral-500"
            datetime={post.data.date.toISOString()}
          >
            {createdOn}
          </time>
        </span>
        <span class="text-neutral-700" aria-hidden="true">·</span>
        <span class="text-neutral-500"> Modified {lastModified}</span>
        <span class="text-neutral-700" aria-hidden="true">·</span>
        <span class="text-neutral-500">
          {remarkPluginFrontmatter.minutesRead}
        </span>
      </div>

      <h1 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-4xl">
        {post.data.title}
      </h1>
      <p class="mt-2 text-sm text-neutral-400">{post.data.description}</p>

      <div class="prose mt-8 border-t border-neutral-800 pt-6 text-neutral-300">
        <Content />
      </div>
    </article>

    <a
      href="/"
      aria-label="Back to all posts"
      class="mt-10 inline-block text-sm text-neutral-400 transition-colors hover:text-cyan-300"
    >
      <span class="text-blue-400">$</span>
      <span class="ml-2">cd ..</span>
    </a>
  </div>
  <script
    src="https://giscus.app/client.js"
    data-repo="bishopcodes/blog"
    data-repo-id="R_kgDOT5sf7Q"
    data-category="General"
    data-category-id="DIC_kwDOT5sf7c4DDeas"
    data-mapping="og:title"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="noborder_dark"
    data-lang="en"
    data-loading="lazy"
    crossorigin="anonymous"
    async></script>
</Layout>
